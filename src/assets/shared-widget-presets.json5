      controlClasses: 'col-sm-10',
      addButtonLabel: 'Add coding',
      showFields: [
        {field: 'display', col: 4, nolabel: true},
        {field: 'code', col: 3, nolabel: true},
        {field: 'system', col: 4, nolabel: true}
      ]
    },
    dialogCodeableConceptObject: {
      id: 'lfb-object',
      labelPosition: 'left',
      labelClasses: 'col-sm-2 ps-0 pe-1',
      controlClasses: 'col-sm-10',
      objectBodyClasses: 'shadow rounded p-1 mb-1',
      showFields: [
        {field: 'text', col: 12},
        {field: 'coding', col: 12}
      ]
    },
    dialogReferenceObject: {
      id: 'lfb-object',
      labelPosition: 'left',
      labelClasses: 'col-sm-2 ps-0 pe-1',
      controlClasses: 'col-sm-10',
      objectBodyClasses: 'shadow rounded p-1 mb-1',
      showFields: [
        {field: 'display', col: 12},
        {field: 'reference', col: 12},
        {field: 'type', col: 12},
        {field: 'identifier', col: 12}
      ]
    },
    formStringField: {
      id: 'string',
      labelPosition: 'left',
      labelClasses: 'col-sm-2 m-0 ps-0 pe-1',
      controlClasses: 'col-sm-10 m-0 p-0'
    },
    formTextareaField: {
